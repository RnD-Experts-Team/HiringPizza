APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hiringpizza
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ===========================================================================
# Hiring service — everything below is the COMPLETE custom configuration.
# Vendor URLs, timeouts etc. are hardcoded in config/tcp.php. This service no
# longer talks to Humanity at all: employees flow
#     HiringPizza -> TCP Manager+ -> (TCP connector) -> Humanity
# ===========================================================================

# pizzasys auth server (AuthTokenStoreScopeMiddleware).
# service_name must equal service_clients.name AND auth_rules.service in
# pizzasys — there is no default; blank fails loudly with a 500.
AUTH_SERVER_BASE_URL=
AUTH_SERVER_SERVICE_NAME=
AUTH_SERVER_CALL_TOKEN=

# Shared-secret header for the export routes. Blank = those routes 500.
X_SECRET_KEY=

# NATS / JetStream. DEV_MODE=1 swaps every subject+stream to its *.testing.*
# twin — it must MATCH OperationsPizza's DEV_MODE or the services silently
# stop talking to each other. Streams and durable consumers are created by
# hand with the NATS CLI (use --deliver=all); the app never calls create().
DEV_MODE=1
NATS_HOST=127.0.0.1
NATS_PORT=4222
NATS_TOKEN=
# ...or NATS_USER= / NATS_PASS= instead of a token.

# ---------------------------------------------------------------------------
# TCP Manager+ / TimeClock Plus — the employee push target. NO SANDBOX
# EXISTS; these credentials are the live account. driver=fake (in-memory
# double) until go-live. Auth is client_credentials.
# ---------------------------------------------------------------------------
TCP_DRIVER=fake
TCP_WRITES_ENABLED=false
TCP_CLIENT_ID=
TCP_CLIENT_SECRET=
TCP_API_KEY=
TCP_COMPANY_ID=1
# Fallback job code for a new hire whose position matches none of their
# store's per-store codes; TCP requires defaultJobCode on create.
TCP_DEFAULT_JOB_CODE=

# ---------------------------------------------------------------------------
# Rollout guard: comma-separated store_numbers whose employees may be pushed
# to TCP. Unset = unrestricted. Start with just the test store.
# ---------------------------------------------------------------------------
EXTERNAL_WRITE_ALLOWED_STORES=

# --- Employee shirt milestones ---------------------------------------------
# Every completed month of tenure opens a shirt milestone.
SHIRT_MILESTONE_INTERVAL_MONTHS=1

# Milestones due before this date are never generated. Set it to the date the
# feature goes live, otherwise the first nightly run backfills every past month
# of every long-tenured employee at once.
SHIRT_MILESTONE_GENERATE_FROM=

# Who fills in the shirt form when a milestone comes due.
SHIRT_MILESTONE_ENTRY_ROLES="Store Manager"

# Who is notified once an entry is submitted, so they can order the shirt and
# mark it delivered. THIS ROLE HAS NOT BEEN CHOSEN YET — while it is empty the
# "entry submitted" notification is skipped with a logged warning rather than
# broadcast to everyone. Set it to the real role name (comma-separated for
# several); no code change is needed. Note this is a notification target only —
# who may call the ordering endpoints is the auth server's call.
SHIRT_MILESTONE_FULFILMENT_ROLES=

# Max upload size for shirt templates and logos, in kilobytes.
SHIRT_MILESTONE_UPLOAD_MAX_KB=2048
