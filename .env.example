APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hiringpizza
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# NATS: we now also CONSUME operations.v1.> so OperationsPizza can ask us to
# push an employee into Humanity. The defaults below are what config/nats.php
# uses (and they flip to *_TESTING_* when DEV_MODE=1) — only set these if your
# broker uses different names. The durable consumer must be created by hand:
#   nats consumer add OPERATIONS_EVENTS HIRING_OPERATIONS_CONSUMER \
#        --filter 'operations.v1.>' --pull
# NATS_OPERATIONS_STREAM=OPERATIONS_EVENTS
# NATS_OPERATIONS_DURABLE=HIRING_OPERATIONS_CONSUMER

# TCP Humanity — employee push (HiringPizza is the ONLY writer of staff)
# Register the app at Humanity -> Settings -> API v2. v2 has no
# client_credentials grant: it authenticates AS a real user whose ROLE is the
# permission model. POST /employees needs Scheduler(4) or better.
HUMANITY_DRIVER=fake
# No default on purpose. Production is live with real users.
HUMANITY_ENV=sandbox
# MUST stay false until humanity:backfill-employee-ids has matched the existing
# live roster, or every employee gets duplicated in Humanity.
HUMANITY_WRITES_ENABLED=false
HUMANITY_BASE_URL=https://www.humanity.com/api/v2
HUMANITY_TOKEN_URL=https://www.humanity.com/oauth2/token.php
HUMANITY_CLIENT_ID=
HUMANITY_CLIENT_SECRET=
HUMANITY_USERNAME=
HUMANITY_PASSWORD=
HUMANITY_REDIRECT_URI=
HUMANITY_TIMEOUT=5
HUMANITY_RETRIES=1
HUMANITY_DEFAULT_GROUP=5
HUMANITY_SEND_ACTIVATION=false
HUMANITY_ID_TYPE_LABEL="Humanity ID"
